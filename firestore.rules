rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isHQ() { return signedIn() && profile().role == 'hq'; }
    function isStaff() { return signedIn() && profile().role == 'staff'; }
    function sameBranch(data) { return isStaff() && data.branch == profile().branch; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isHQ());
      // Create/update user role documents only from Firebase Console or trusted Admin SDK.
      allow write: if false;
    }
    match /orders/{orderId} {
      allow read: if isHQ() || (isStaff() && resource.data.branch == profile().branch);
      allow create: if isStaff()
        && request.resource.data.status == 'Pending'
        && request.resource.data.branch == profile().branch
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;
      allow update: if (isHQ() && (
          (resource.data.status == 'Pending'
            && request.resource.data.status == 'Accepted'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt', 'updatedAt', 'updatedBy']))
          || (resource.data.status == 'Accepted'
            && request.resource.data.status == 'Dispatched'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'invoiceNo', 'dispatchMethod', 'dispatchThrough', 'trackingNo', 'dispatchedAt', 'updatedAt', 'updatedBy']))
        )) || (sameBranch(resource.data)
          && resource.data.status == 'Dispatched'
          && request.resource.data.status == 'Received'
          && request.resource.data.branch == resource.data.branch
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'grnNo', 'receivedBy', 'deliveryDate', 'grnRemarks', 'receivedItems', 'receivedAt', 'updatedAt', 'updatedBy']));
      allow delete: if false;
    }
  }
}
